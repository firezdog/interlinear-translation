  "segments": [
    {
      "text": "尋 西山 隱者 不遇",
      "start": 0,
      "end": 3
    },
    {
      "text": "絕頂 一 茅茨，",
      "start": 4,
      "end": 6
    },
    {
      "text": "直上 三十 里；",
      "start": 7,
      "end": 9
    },
    {
      "text": "扣關 無 僮僕，",
      "start": 10,
      "end": 12
    },
    {
      "text": "窺室 惟 案几。",
      "start": 13,
      "end": 15
    },
    {
      "text": "若非 巾 柴車？",
      "start": 16,
      "end": 18
    },
    {
      "text": "應是 釣 秋水。",
      "start": 19,
      "end": 21
    },
    {
      "text": "差池 不 相見，",
      "start": 22,
      "end": 24
    },
    {
      "text": "黽勉 空 仰止。",
      "start": 25,
      "end": 27
    },
    {
      "text": "草色 新雨 中，",
      "start": 28,
      "end": 30
    },
    {
      "text": "松聲 晚窗 裡；",
      "start": 31,
      "end": 33
    },
    {
      "text": "及茲 契 幽絕，",
      "start": 34,
      "end": 36
    },
    {
      "text": "自足 蕩 心耳。",
      "start": 37,
      "end": 39
    },
    {
      "text": "雖無 賓主 意，",
      "start": 40,
      "end": 42
    },
    {
      "text": "頗得 清淨 理。",
      "start": 43,
      "end": 45
    },
    {
      "text": "興盡 方 下山，",
      "start": 46,
      "end": 48
    },
    {
      "text": "何必 待 之子。",
      "start": 49,
      "end": 51
    }
  ],
